{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "imify error envelope",
  "description": "Written to stderr when a command fails with --json.",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "hint"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Stable error code. The exit code depends on it.",
          "enum": [
            "internal",
            "invalid_argument",
            "auth_required",
            "auth_rejected",
            "auth_expired",
            "login_failed",
            "permission_denied",
            "not_found",
            "dataset_invalid",
            "conflict",
            "network",
            "server",
            "rate_limited",
            "cancelled",
            "interrupted",
            "self_update_unsupported",
            "self_update_failed",
            "io"
          ]
        },
        "message": {
          "description": "What happened.",
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "description": "What to do next, or null.",
          "type": ["string", "null"]
        }
      }
    }
  }
}
